<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="refresh" content="{{ wait_seconds }};url={{ target_url }}">
    <title>Libertea</title>
    <script>
        /* Applied before first paint to avoid a light-mode flash. */
        (function() {
            try {
                var stored = localStorage.getItem('libertea-theme');
                var dark = stored ? stored === 'dark' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (dark) {
                    document.documentElement.classList.add('dark-mode');
                }
            } catch (e) {}
        })();
    </script>
    <style>
        body {
            font-family: 'Segoe UI', Roboto, Arial, sans-serif;
            background: #f7f7f9;
            color: #333;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }
        html.dark-mode {
            color-scheme: dark;
        }
        html.dark-mode body {
            background: #16181b;
            color: #d8dade;
        }
        .box {
            text-align: center;
        }
        .spinner {
            width: 42px;
            height: 42px;
            margin: 0 auto 18px;
            border-radius: 50%;
            border: 4px solid #eee;
            border-top-color: #E55977;
            animation: spin 0.8s linear infinite;
        }
        html.dark-mode .spinner {
            border-color: #333740;
            border-top-color: #E55977;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        p {
            opacity: 0.7;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="box">
        <div class="spinner"></div>
        <div>{{ message }}</div>
        <p id="countdown"></p>
    </div>
    <script>
        // The server applies the change (haproxy/sing-box restart) in the
        // background after this page is delivered. Wait, then probe until
        // the panel is reachable again so we don't navigate into a dead tunnel.
        var target = {{ target_url | tojson }};
        var reloadingUrl = {{ reloading_url | tojson }};
        var remaining = {{ wait_seconds }};
        var countdownEl = document.getElementById('countdown');

        if (window.history && history.replaceState) {
            try { history.replaceState(null, '', reloadingUrl); } catch (e) {}
        }

        function probeAndGo() {
            countdownEl.textContent = 'Waiting for server…';
            fetch(target, { method: 'GET', cache: 'no-store', redirect: 'follow' })
                .then(function(r) {
                    if (r.ok) {
                        window.location.replace(target);
                        return;
                    }
                    setTimeout(probeAndGo, 1000);
                })
                .catch(function() {
                    setTimeout(probeAndGo, 1000);
                });
        }

        function tick() {
            countdownEl.textContent = remaining > 0 ? ('Redirecting in ' + remaining + 's…') : 'Redirecting…';
            if (remaining <= 0) {
                probeAndGo();
                return;
            }
            remaining -= 1;
            setTimeout(tick, 1000);
        }
        tick();
    </script>
</body>
</html>
