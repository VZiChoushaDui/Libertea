<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <script>
            /* Applied before first paint to avoid a light-mode flash. */
            (function() {
                try {
                    var stored = localStorage.getItem('libertea-theme');
                    var dark = stored ? stored === 'dark' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
                    if (dark) {
                        document.documentElement.classList.add('dark-mode');
                    }
                } catch (e) {}
            })();
        </script>
        <title>Libertea</title>
        <link href="{{ static_prefix }}/vendor/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
        <script src="{{ static_prefix }}/vendor/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="{{ static_prefix }}/vendor/css/fontawesome.min.css" integrity="sha512-MV7K8+y+gLIBoVD59lQIYicR65iaqukzvf/nwasF0nqhPay5w/9lJmVM2hMDcnK1OnMGCdVK+iQrJ7lzPJQd1w==" crossorigin="anonymous" referrerpolicy="no-referrer" />
        <script src="{{ static_prefix }}/vendor/js/qrcode.min.js"></script>
        <link href='{{ static_prefix }}/vendor/css/roboto.css' rel="stylesheet">
        <script src="{{ static_prefix }}/vendor/js/chart.umd.min.js" integrity="sha512-GCiwmzA0bNGVsp1otzTJ4LWQT2jjGJENLGyLlerlzckNI30moi2EQT0AfRI7fLYYYDKR+7hnuh35r3y1uJzugw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        <script src="{{ static_prefix }}/vendor/js/hammer.min.js"></script>
        <script src="{{ static_prefix }}/vendor/js/chartjs-plugin-zoom.min.js" integrity="sha256-MWgfT8qLAHB0HjurfqDyahw+t9fzVXwbLWKVJ8uTaec=" crossorigin="anonymous"></script>
        <style> 
            body {
                font-family: 'Roboto', sans-serif;
            }
            
            .btn-primary, .form-check-input:checked {
                background: #E55977;
                border-color: #E55977;
            }

            .btn-primary:hover {
                background: #B5465E;
                border-color: #B5465E;
            }

            .btn-outline-primary {
                border-color: #E55977;
                color: #CC4F6A;
            }

            .btn-outline-primary:hover {
                border-color: #E55977;
                background: #FFE8ED;
                color: #CC4F6A;
            }

            a, .btn-link {
                color: #CC4F6A;
            }

            a:hover, .btn-link:hover {
                color: #B5465E;
            }

            h1 {
                font-size: 20px;
                text-align: center;
            }

            .section {
                width: 100%;
                margin-top: 20px;
                padding-left: 16px;
                padding-right: 16px;
            }

            .stats-item {
                margin-top: 16px;
            }

            .stats-item-value {
                font-size: 28px;
                font-weight: 300;
            }

            .stats-item-desc {
                font-size: 14px;
                font-weight: 700;
                text-transform: uppercase;
                margin-top: -4px;
                margin-bottom: 8px;
            }

            .actions .btn {
                width: 100%;
                margin-top: 16px;
            }

            .tabs .tab {
                border-bottom: 3px solid transparent;
                display: inline-block;
                text-decoration: none;
                font-size: 16px;
                margin-right: 4px;
                color: black;
                font-weight: 400;
            }

            @media (min-width: 400px) {
                .tabs .tab {
                    margin-right: 16px;
                }
            }

            .tabs .tab.active {
                border-bottom: 3px solid #CC4F6A;
                color: #CC4F6A;
                font-weight: 600;
            }

            .tabs .tab.back {
                color: #CC4F6A;
                font-weight: 600;
            }

            .list-item-title {
                font-size: 16px;
                font-weight: 600;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .list-item-subtitle {
                font-size: 14px;
                opacity: 0.75;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .list-item-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                text-align: center;
                font-size: 11px;
                font-weight: 900;
                background: #dadada;
                padding: 0;
                transform: translateY(-2px);
            }

            .main-content {
                max-width: 900px;
                margin: 0 auto;
            }
            
            
            .qr-modal {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.5);
                backdrop-filter: blur(10px);
                display: none;
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: 999;
            }

            .qr-modal-content {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                height: 100%;
            }

            #qr-code {
                border: 20px solid white;
                background: white;
                border-radius: 10px;
            }

            #qr-code img {
                margin-left: auto;
                margin-right: auto;
            }

            .header {
                width: 100%;
                padding-top: 20px;
                padding-left: 16px;
                padding-right: 16px;
                background: #eee;
            }

            .header > div {
                max-width: 900px;
                margin: 0 auto;
            }

            .logo {
                float: left;
                margin-top: -18px;
            }

            @media (max-width: 576px) {
                .logo {
                    float: none;
                    text-align: center;
                    margin-bottom: 16px;
                }
            }

            .logo > img {
                max-width: 140px;
            }

            h6 {
                font-size: 14px;
                font-weight: 900;
                margin-top: 20px;
            }
            
            h6.bordered {
                border-bottom: 1px solid #999;
                padding-bottom: 4px;
            }

            .libertea-top-logo {
                width: 130px;
                max-width: 30vw;
            }

            .libertea-top-logo-big {
                width: 200px;
                max-width: 60vw;
            }

            .theme-toggle-btn {
                position: fixed;
                top: 16px;
                right: 16px;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                border: 1px solid rgba(0, 0, 0, 0.08);
                background: rgba(0, 0, 0, 0.05);
                color: #555;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                z-index: 10;
                transition: background-color 0.2s ease, color 0.2s ease;
            }

            .theme-toggle-btn:hover {
                background: rgba(0, 0, 0, 0.1);
            }

            .theme-toggle-btn .icon-sun {
                display: none;
            }

            /* Dark mode theme, toggled via the "dark-mode" class on <html> */
            html.dark-mode {
                color-scheme: dark;
                --bs-tertiary-bg: #22252c;
                --bs-secondary-bg: #2a2d35;
                --bs-border-color: #383c45;
            }

            html.dark-mode body {
                background-color: #16181b;
                color: #d8dade;
            }

            html.dark-mode .theme-toggle-btn {
                border-color: rgba(255, 255, 255, 0.12);
                background: rgba(255, 255, 255, 0.08);
                color: #d8dade;
            }

            html.dark-mode .theme-toggle-btn:hover {
                background: rgba(255, 255, 255, 0.16);
            }

            html.dark-mode .theme-toggle-btn .icon-moon {
                display: none;
            }

            html.dark-mode .theme-toggle-btn .icon-sun {
                display: inline-block;
            }

            html.dark-mode a:not(.btn),
            html.dark-mode .btn-link {
                color: #FF8FA3;
            }

            html.dark-mode a:not(.btn):hover,
            html.dark-mode .btn-link:hover {
                color: #ffb6c4;
            }

            html.dark-mode .btn-outline-primary {
                border-color: #E55977;
                color: #FF8FA3;
            }

            html.dark-mode .btn-outline-primary:hover {
                background: rgba(229, 89, 119, 0.15);
                color: #FF8FA3;
            }

            html.dark-mode .form-control,
            html.dark-mode .form-select {
                background-color: #1e2127;
                color: #d8dade;
                border-color: #3a3f4a;
            }

            html.dark-mode .form-control:focus,
            html.dark-mode .form-select:focus {
                background-color: #1e2127;
                color: #d8dade;
                border-color: #E55977;
                box-shadow: 0 0 0 0.25rem rgba(229, 89, 119, 0.25);
            }

            html.dark-mode .form-check-input {
                background-color: #1e2127;
                border-color: #5a5f6a;
            }

            html.dark-mode h6.bordered {
                border-bottom-color: #3a3f4a;
            }
        </style>
    </head>
    <body>
        <button type="button" id="theme-toggle" class="theme-toggle-btn" title="Toggle dark mode" aria-label="Toggle dark mode">
            <i class="fa-solid fa-moon icon-moon"></i>
            <i class="fa-solid fa-sun icon-sun"></i>
        </button>
        <div class="main-content" style="max-width: 600px; margin: 0 auto; padding: 0 30px;">
            {% block content %}
            {% endblock %}
        </div>
        <script>
            (function() {
                var toggle = document.getElementById('theme-toggle');
                if (!toggle) return;
                toggle.addEventListener('click', function() {
                    var isDark = document.documentElement.classList.contains('dark-mode');
                    try {
                        localStorage.setItem('libertea-theme', isDark ? 'light' : 'dark');
                    } catch (e) {}
                    location.reload();
                });
            })();
        </script>
    </body>
</html>